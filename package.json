{
  "name": "embryo-inventory-electron",
  "version": "1.0.0",
  "description": "胚胎实验室库存管理系统（Electron + Vue3 + Element Plus + SQLite3）",
  "main": "src/main/index.js",
  "author": "Doubao Replica",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "jsbarcode": "^3.11.6",
    "jszip": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "element-plus": "^2.9.1",
    "@element-plus/icons-vue": "^2.3.1",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "build": {
    "appId": "com.doubao.embryoinventory",
    "productName": "胚胎实验室库存管理",
    "publish": "never",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/renderer/**",
      "src/main/**",
      "src/preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "胚胎实验室库存管理"
    },
    "portable": {
      "artifactName": "${productName}-portable-${version}.exe",
      "requestExecutionLevel": "user"
    },
    "npmRebuild": true,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}
